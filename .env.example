# AI Gateway Environment Variables

# Admin token for management API (required)
ADMIN_TOKEN=admin-xxxxxxxxxxxxxxxx

# Grafana admin password (optional, default: admin)
GRAFANA_PASSWORD=admin

# Database DSN (for MySQL/PostgreSQL in production)
# MYSQL_DSN=user:password@tcp(localhost:3306)/aigateway?charset=utf8mb4&parseTime=True
# POSTGRES_DSN=postgres://user:password@localhost:5432/aigateway?sslmode=disable

# Redis address (for Docker: redis:6379)
# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=

# Jaeger tracing endpoint (optional)
# JAEGER_ENDPOINT=http://localhost:14268/api/traces
